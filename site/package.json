{
  "name": "yogine-site",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "sync": "node scripts/sync-catalog.mjs",
    "predev": "npm run sync",
    "dev": "astro dev",
    "dev:fixture": "cross-env YOGINE_CATALOG=catalog.fixture.json npm run sync && cross-env YOGINE_CATALOG=catalog.fixture.json astro dev",
    "prebuild": "npm run sync",
    "build": "astro build",
    "build:fixture": "cross-env YOGINE_CATALOG=catalog.fixture.json npm run sync && cross-env YOGINE_CATALOG=catalog.fixture.json astro build --outDir dist-fixture && node scripts/strip-private.mjs dist-fixture",
    "preview": "astro preview",
    "test": "node --test --test-concurrency=1 \"tests/**/*.test.mjs\"",
    "pretest": "npm run build:fixture",
    "postbuild": "node scripts/strip-private.mjs dist",
    "build:staging": "cross-env YOGINE_STRIPE_MODE=test npm run build"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "astro": "^7.4.2",
    "posthog-js": "^1.438.21"
  },
  "devDependencies": {
    "axe-core": "^4.14.0",
    "cross-env": "^10.1.0"
  }
}
