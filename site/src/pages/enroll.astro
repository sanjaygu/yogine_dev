---
import Base from '../layouts/Base.astro';
import WaitlistForm from '../components/WaitlistForm.astro';
import { COURSES, SESSIONS, sessionLocation, sessionAddress } from '../lib/catalog.js';

const data = {
  courses: COURSES.filter((c) => !c.custom).map((c) => ({ slug: c.slug, name: c.name, free: Boolean(c.free), price: c.price, paymentLink: c.paymentLink || '' })),
  sessions: SESSIONS.map((s) => ({ id: s.id, course: s.course, date: s.date, start: s.start, end: s.end, where: sessionLocation(s), address: sessionAddress(s) })),
};
---
<Base path="/enroll/" cta={null} title="Reserve a seat — yogine.dev" description="Reserve a seat in a yogine.dev workshop.">
  <div class="page wrap tall-page">
    <div class="page-card">
      <h1 style="font-size: 1.9rem;">Reserve a seat</h1>
      <noscript>
        <div class="notice">
          This page needs JavaScript. To reserve a seat without it, write to
          <a class="text-link" href="mailto:hello@yogine.dev?subject=Reserve%20a%20seat">hello@yogine.dev</a>.
        </div>
      </noscript>

      <div id="enrollApp" hidden>
        <div class="field form-card">
          <label for="enroll-course">Course</label>
          <select id="enroll-course" name="course"></select>
          <p class="field-hint">Training a whole team, or the Enterprise program? <a class="text-link" href="/contact/?interest=enterprise-training">Talk to us</a>.</p>
        </div>

        <form id="enrollForm" class="form-card" method="post" novalidate>
          <div data-error-summary class="error-summary" tabindex="-1" role="alert" hidden></div>

          <fieldset class="field" id="sessionField">
            <legend>Session</legend>
            <div id="sessionList"></div>
            <p class="field-error" data-error-for="session" id="err-session" hidden></p>
          </fieldset>

          <div class="field">
            <label for="enroll-name">Full name</label>
            <input type="text" name="name" id="enroll-name" autocomplete="name" />
            <p class="field-error" data-error-for="name" id="err-name" hidden></p>
          </div>
          <div class="field-row">
            <div class="field">
              <label for="enroll-email">Email</label>
              <input type="email" name="email" id="enroll-email" autocomplete="email" inputmode="email" data-describe="enroll-email-hint" />
              <p class="field-hint" id="enroll-email-hint">Your confirmation is sent here.</p>
              <p class="field-error" data-error-for="email" id="err-email" hidden></p>
            </div>
            <div class="field">
              <label for="enroll-phone">Phone <span class="optional-tag">(optional)</span></label>
              <input type="tel" name="phone" id="enroll-phone" autocomplete="tel" inputmode="tel" />
              <p class="field-error" data-error-for="phone" id="err-phone" hidden></p>
            </div>
          </div>

          <div class="hp" aria-hidden="true"><label>Leave this field empty<input type="text" name="website" tabindex="-1" autocomplete="off" /></label></div>

          <p class="form-note">
            When you continue, we save these details so we can follow up if you don't finish registering, and we note which page
            you came from. See our <a href="/privacy/">privacy notice</a>.
            <span id="payNote">Read the <a href="/refund-policy/">Refund &amp; Cancellation Policy</a> before you pay.</span>
          </p>
          <p class="form-error" data-form-error role="alert" hidden></p>
          <div class="form-actions">
            <button type="submit" class="btn btn-primary" id="enrollSubmit">Continue</button>
          </div>
        </form>

        <section id="waitlistPanel" class="panel" hidden aria-labelledby="waitlistHeading">
          <h2 id="waitlistHeading">No date is published for this course yet</h2>
          <p id="waitlistReason">Tell us how to reach you and we will let you know when one is.</p>
          <WaitlistForm idp="ew" />
        </section>
      </div>
      <script type="application/json" id="enroll-data" set:html={JSON.stringify(data)} />
    </div>
  </div>
  <script>
    import '../scripts/enroll.js';
  </script>
</Base>
