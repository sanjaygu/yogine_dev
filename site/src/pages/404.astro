---
import Base from '../layouts/Base.astro';
---
<Base path="/404/" title="Page not found — yogine.dev" description="This page does not exist.">
  <div class="page wrap">
    <div class="page-card">
      <h1 style="font-size: 1.9rem;">That page doesn't exist</h1>
      <p style="color: var(--color-muted);">It may have moved. Try one of these instead.</p>
      <p style="display: flex; gap: 12px; flex-wrap: wrap;">
        <a href="/training/" class="btn btn-ghost">Training</a>
        <a href="/solutions/" class="btn btn-ghost">Solutions</a>
        <a href="/sessions/" class="btn btn-ghost">Sessions</a>
      </p>
    </div>
  </div>
</Base>
