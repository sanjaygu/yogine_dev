---
import { COURSES } from '../lib/catalog.js';

const { idp = 'wl' } = Astro.props;
const courses = COURSES.filter((c) => !c.custom);
---
<form data-form="waitlist" data-success={`${idp}-success`} id={`${idp}-form`} class="form-card" method="post" novalidate>
  <div data-error-summary class="error-summary" tabindex="-1" role="alert" hidden></div>

  <fieldset class="field" data-field="courses">
    <legend>Which courses are you interested in?</legend>
    <div class="check-list">
      {courses.map((c) => (
        <label class="check-pick">
          <input type="checkbox" name="courses" value={c.slug} id={`${idp}-course-${c.slug}`} />
          <span>{c.name}</span>
        </label>
      ))}
    </div>
    <p class="field-error" data-error-for="courses" id={`${idp}-err-courses`} hidden></p>
  </fieldset>

  <div class="field">
    <label for={`${idp}-name`}>Name <span class="optional-tag">(optional)</span></label>
    <input type="text" name="name" id={`${idp}-name`} autocomplete="name" />
  </div>

  <p class="form-note" style="margin-bottom: 8px;">Give an email, a phone number, or both.</p>
  <p class="field-error" data-error-for="contact" id={`${idp}-err-contact`} hidden></p>
  <div class="field-row">
    <div class="field">
      <label for={`${idp}-email`}>Email</label>
      <input type="email" name="email" id={`${idp}-email`} autocomplete="email" inputmode="email" />
      <p class="field-error" data-error-for="email" id={`${idp}-err-email`} hidden></p>
    </div>
    <div class="field">
      <label for={`${idp}-phone`}>Phone</label>
      <input type="tel" name="phone" id={`${idp}-phone`} autocomplete="tel" inputmode="tel" />
      <p class="field-error" data-error-for="phone" id={`${idp}-err-phone`} hidden></p>
    </div>
  </div>

  <div class="field">
    <label for={`${idp}-note`}>Anything we should know? <span class="optional-tag">(optional)</span></label>
    <textarea name="note" id={`${idp}-note`} rows="3" placeholder="For example: weekends only, or virtual preferred"></textarea>
  </div>

  <div class="hp" aria-hidden="true"><label>Leave this field empty<input type="text" name="website" tabindex="-1" autocomplete="off" /></label></div>

  <p class="form-note">
    We use these details to let you know when a date is published, and we note which page you came from. See our
    <a href="/privacy/">privacy notice</a>.
  </p>
  <noscript><p class="notice">This form needs JavaScript. To join the waitlist without it, write to <a class="text-link" href="mailto:hello@yogine.dev?subject=Notify%20me%20when%20a%20session%20is%20scheduled">hello@yogine.dev</a>.</p></noscript>
  <p class="form-error" data-form-error role="alert" hidden></p>
  <div class="form-actions">
    <button type="submit" class="btn btn-primary" disabled>Notify me when scheduled</button>
  </div>
</form>
<div id={`${idp}-success`} class="form-success" hidden></div>
<script>
  import '../scripts/forms.js';
</script>
